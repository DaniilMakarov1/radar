FUNDING_PAPER_ENTRY_MAX_LEAD_SECONDS=35
FUNDING_PAPER_ARM_WINDOW_SECONDS=120
FUNDING_PAPER_FINAL_RECHECK_FREEZE_SECONDS=0
FUNDING_PAPER_MAX_ENTRY_SNAPSHOT_AGE_SECONDS=2
FUNDING_PAPER_MONITOR_INTERVAL_SECONDS=2
FUNDING_PAPER_HOT_INTERVAL_SECONDS=1
