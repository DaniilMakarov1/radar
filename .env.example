FUNDING_PAPER_COMMON_PRICE_MOVE_CRITICAL_PCT=10

# Legacy optional X gate. Research Validity V2 uses Attention Gap without X.
X_SOCIAL_GATE_ENABLED=0

# Optional account fee tiers for Funding Radar. Values are decimal rates.
